{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcana",
  "identifier": "com.erone.arcana",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arcana",
        "width": 480,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#07080d"
      },
      {
        "label": "quick",
        "title": "Arcana 빠른 호출",
        "url": "quick.html",
        "width": 1280,
        "height": 720,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}